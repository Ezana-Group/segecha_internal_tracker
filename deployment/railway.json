{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "server": {
      "name": "backend-api",
      "source": {
        "root": "server"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 100
      }
    },
    "tracker": {
      "name": "admin-tracker",
      "source": {
        "root": "/"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm run preview -- --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/",
        "healthcheckTimeout": 100
      }
    }
  }
}
