# ─────────────────────────────────────────────────────────────────────
# DNS RECORDS — add these in Cloudflare (or your DNS provider)
# Replace YOUR-RENDER-APP with your actual Render app slug
# ─────────────────────────────────────────────────────────────────────
#
# TYPE    NAME        VALUE
# A       @           76.76.21.21                    (Vercel root IP)
# CNAME   www         cname.vercel-dns.com           (www redirect)
# CNAME   app         cname.vercel-dns.com           (main tracker)
# CNAME   payment     cname.vercel-dns.com           (payment portal)
# CNAME   driver      cname.vercel-dns.com           (driver portal)
# CNAME   track       cname.vercel-dns.com           (shipment tracker)
# CNAME   api         YOUR-RENDER-APP.onrender.com   (API server)
#
# SENDGRID (domain authentication — get exact values from SendGrid dashboard)
# CNAME   em1234      u1234567.wl1234.sendgrid.net
# CNAME   s1._domainkey  s1.domainkey.u1234567.wl1234.sendgrid.net
# CNAME   s2._domainkey  s2.domainkey.u1234567.wl1234.sendgrid.net
#
# EMAIL INBOXES (Google Workspace MX records — get from Google Admin)
# MX      @           aspmx.l.google.com   priority 1
# MX      @           alt1.aspmx.l.google.com  priority 5
# MX      @           alt2.aspmx.l.google.com  priority 5
#
# Note: Cloudflare proxy (orange cloud) — ON for app/payment/driver/track
#       Cloudflare proxy — OFF for api (Daraja callbacks need direct IP)
# ─────────────────────────────────────────────────────────────────────

# ── Server
PORT=3001
NODE_ENV=production

# ── Domain config
API_URL=https://api.segecha.com
APP_URL=https://app.segecha.com
PAYMENT_PORTAL_URL=https://payment.segecha.com
DRIVER_PORTAL_URL=https://driver.segecha.com
TRACKER_URL=https://app.segecha.com

