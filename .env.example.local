# =============================================================================
# Segecha — environment variable reference (local development)
# =============================================================================
#
# This file is NOT loaded automatically. Copy the blocks below into real files:
#
#   Repo root/.env              → main tracker (Vite) — MUST be named .env or .env.local
#   driver-portal/.env          → driver mobile web app
#   payment-portal/.env         → client payment page
#   server/.env                 → Node API (Express)
#
# Local dev URLs (after `npm run dev` in each folder):
#   Main tracker     http://localhost:5173   (repo root)
#   Driver portal    http://localhost:5174   (driver-portal/)
#   Payment portal   http://localhost:5175   (payment-portal/)
#   API              http://localhost:3001   (server/)
#
# If http://localhost:5174 says “site can’t be reached”, start the driver app:
#   cd driver-portal && npm install && npm run dev
#
# =============================================================================


# ┌───────────────────────────────────────────────────────────────────────────┐
# │ MAIN TRACKER (repo root) — prefix VITE_ (exposed to the browser)           │
# └───────────────────────────────────────────────────────────────────────────┘
# Copy these into:  ./.env

VITE_API_URL=http://localhost:3001
# Must match server ADMIN_KEY (sent with sync / document uploads — treat as secret in production)
VITE_ADMIN_KEY=segecha-admin-key-change-this
# Link shown in tracker for “open driver app” — use local driver dev URL or production URL
VITE_DRIVER_PORTAL_URL=http://localhost:5174
# Optional: default tyre warning threshold (km) if not set in Settings UI
# VITE_TYRE_WARNING_KM=5000


# ┌───────────────────────────────────────────────────────────────────────────┐
# │ DRIVER PORTAL (driver-portal/)                                             │
# └───────────────────────────────────────────────────────────────────────────┘
# Copy these into:  ./driver-portal/.env

VITE_API_URL=http://localhost:3001
# E.164 digits only, no + — used for WhatsApp “contact office” deep links
VITE_OFFICE_WHATSAPP=254700000000


# ┌───────────────────────────────────────────────────────────────────────────┐
# │ PAYMENT PORTAL (payment-portal/)                                           │
# └───────────────────────────────────────────────────────────────────────────┘
# Copy these into:  ./payment-portal/.env

VITE_API_URL=http://localhost:3001
# Flutterwave public key (optional — only if you use that checkout path in the portal)
# VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx


# ┌───────────────────────────────────────────────────────────────────────────┐
# │ API SERVER (server/) — Node / Express — NEVER expose these to the browser   │
# └───────────────────────────────────────────────────────────────────────────┘
# Copy these into:  ./server/.env

PORT=3001
# Must match VITE_ADMIN_KEY on the tracker for /api/tracker/sync and admin routes
ADMIN_KEY=segecha-admin-key-change-this
# Signing driver JWTs — use a long random string in production
JWT_SECRET=segecha-driver-secret-change-in-production

# Public site URLs (CORS + links in emails/SMS). Use your real HTTPS origins in production.
TRACKER_URL=http://localhost:5173
PORTAL_URL=http://localhost:5175
DRIVER_PORTAL_URL=http://localhost:5174

# Brand / defaults (fallbacks when tracker JSON or settings are not available)
COMPANY_NAME=Segecha Group Ltd
MPESA_PAYBILL=
BANK_NAME=
BANK_ACCOUNT=
BANK_BRANCH=

# M-Pesa Daraja (STK push, callbacks)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be publicly reachable in production (Safaricom POSTs here)
MPESA_CALLBACK_URL=https://your-api.example.com/api/mpesa/callback

# SendGrid (invoice / receipt / driver emails)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Segecha Logistics
# Optional overrides for driver-facing mail
# DRIVER_EMAIL_FROM=
# DRIVER_EMAIL_FROM_NAME=

# Africa’s Talking (SMS)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=SEGECHA

# Cloudinary — image/* uploads (office + driver); leave blank for data URLs in dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 — PDFs & non-image files; also stores images if Cloudinary is unset
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=segecha-documents
R2_PUBLIC_URL=

# Optional: JSON string of settings for server-side email templates when no DB
# CACHED_SETTINGS={"companyName":"Segecha"}

# Payslip dispatch queue worker (optional)
# PAYSLIP_DISPATCH_CRON_ENABLED=true
# PAYSLIP_DISPATCH_CRON_MS=60000
# PAYSLIP_DISPATCH_BATCH_SIZE=20
