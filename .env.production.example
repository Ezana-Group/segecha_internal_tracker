# --- SEGECHA PRODUCTION CONFIGURATION ---

# 1. Database (Neon.tech)
# Find this in your Neon Dashboard (Connection String)
DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require

# 2. Security (Hardening)
# Generate a long random string for JWT signing
JWT_SECRET=generate_a_long_random_string_here
# Your master key for initial setup/legacy tool access
ADMIN_KEY=your_secure_admin_key_here

# 3. Initial Setup (Used by /api/admin/reset)
INITIAL_ADMIN_EMAIL=admin@segecha.com
INITIAL_ADMIN_PHONE=+254700000000

# 4. Environment
NODE_ENV=production
# Railway provides PORT automatically
