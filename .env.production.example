# --- SEGECHA PRODUCTION CONFIGURATION ---

# 1. API & Frontend Config (Vite)
# The public URL of your backend API
VITE_API_URL=https://api.segecha.com
VITE_ADMIN_KEY=your_secure_admin_key_here
VITE_COMPANY_NAME="Segecha Group Ltd"

# 2. Database (Neon.tech)
DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require

# 3. Security (Hardening)
JWT_SECRET=generate_a_64_char_random_string_here
ADMIN_KEY=your_64_char_secure_admin_key_here

# 4. M-Pesa Daraja (STK Push)
MPESA_ENV=production
MPESA_CONSUMER_KEY=your_live_consumer_key
MPESA_CONSUMER_SECRET=your_live_consumer_secret
MPESA_SHORTCODE=your_live_shortcode
MPESA_PASSKEY=your_live_passkey
MPESA_CALLBACK_URL=https://api.segecha.com/api/mpesa/callback

# 5. Storage — uploads are routed automatically when these are set:
#    • image/*  → Cloudinary (photos: fuel, receipts, inline admin/driver uploads)
#    • PDF & other files → Cloudflare R2 (documents); images also go to R2 if Cloudinary is not set
#    • Omit or leave placeholders → legacy data: URLs (large JSON / 413 risk)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CF_ACCOUNT_ID=your_cloudflare_id
R2_ACCESS_KEY_ID=your_r2_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=segecha-documents
# Public base URL for R2 objects (pub-*.r2.dev or your custom domain — add custom domain to CSP via code if not r2.dev)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
# When R2 is set: JSON backups are mirrored under backups/; list/download/restore fall back to R2 if the local file is missing.

# 6. Communication (SendGrid & Africa's Talking)
SENDGRID_API_KEY=SG.your_live_key
EMAIL_FROM=payments@segecha.com
EMAIL_FROM_NAME="Segecha Group Ltd"

AT_USERNAME=your_live_username
AT_API_KEY=your_live_api_key
AT_SENDER_ID=SEGECHA

# 7. Operational Settings
VITE_VAT_RATE=0.16
VITE_TYRE_WARNING_KM=5000
VITE_INVOICE_OVERDUE_DAYS=30

# 8. Environment
NODE_ENV=production
# PORT is typically provided by the hosting platform (Railway/Render)
